{
  "permissions": {
    "allow": [
      "List(*)",
      "Fetch(https://*)",
      "Edit(*)",
      "Write(~/Project/q/**)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(go:*)",
      "Bash(make:*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/.config/polybar/claude-code-status.sh stopped"
          },
          {
            "type": "command",
            "command": "~/dotfiles/scripts/notify.sh 'Claude: 通知'"
          },
          {
            "type": "command",
            "command": "XDG_RUNTIME_DIR='/run/user/1000' ~/.nix-profile/bin/aplay ~/dotfiles/sounds/suzu.wav"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/.config/polybar/claude-code-status.sh active"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/.config/polybar/claude-code-status.sh stopped"
          },
          {
            "type": "command",
            "command": "~/dotfiles/scripts/notify.sh 'Claude: 終了'"
          },
          {
            "type": "command",
            "command": "~/dotfiles/scripts/discord.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "XDG_RUNTIME_DIR='/run/user/1000' ~/.nix-profile/bin/aplay ~/dotfiles/sounds/area-transition.wav"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/dotfiles/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "outputStyle": "Explanatory",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
